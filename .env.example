# Скопируй этот файл в .env и заполни значения
# .env никогда не коммитить в git

# Окружение: local | production
APP_ENV=local
APP_URL=http://localhost
APP_NAME=Сдоба

# База данных
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Логгер
APP_LOG_LEVEL=error

# Стартовый админ — используется database/seed-core.php при развёртывании.
# Пароль минимум 8 символов. SEED_ADMIN_NAME необязателен (по умолчанию «Администратор»).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Администратор

# Общий пароль демо-кондитеров из database/seed.php (минимум 8 символов).
# Пусто — сид ставит каждому случайный пароль, войти под ними будет нельзя.
SEED_DEMO_PASSWORD=

# Email (SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Сдоба
MAIL_ENCRYPTION=tls

# Платежи — ЮKassa
# В тестовом магазине YOOKASSA_SHOP_ID и YOOKASSA_SECRET_KEY берутся
# из личного кабинета. Секрет вебхука проверяется до доверия payload.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=1
YOOKASSA_RETURN_URL=http://localhost/order/success
